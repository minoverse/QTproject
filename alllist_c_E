static volatile uint8_t pkt_len[NUM_PKTS];  // 각 패킷 길이

bool push_packet(const uint8_t* data, uint8_t len) {
    uint16_t next_head = (pkt_head + 1) % NUM_PKTS;
    if (next_head == pkt_tail) return false;  // Full
    
