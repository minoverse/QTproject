void* fast_memcpy(void* dest, const void* src, size_t n) {
    uint32_t* d = (uint32_t*)dest;
    const uint32_t* s = (const uint32_t*)src;
    uint8_t* d8, *s8;
    
    // 4바이트 단위 복사
    while (n >= 4) {
        *d++ = *s++;
        n -= 4;
    }
    
    // 남은 바이트
    d8 = (uint8_t*)d; s8 = (const uint8_t*)s;
    while (n--) *d8++ = *s8++;
    
    return dest;
}
