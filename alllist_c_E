Lock-free Ring Buffer 완전 구현 (ISR → Main)
c
#define BUF_SIZE 1024
#define MASK (BUF_SIZE - 1)  // 1023

static int buffer[BUF_SIZE];
static volatile int head = 0;  // ISR WRITE → volatile 필수
static volatile int tail = 0;  // Main READ → volatile 필수

// Producer: RX_ISR (실시간 IQ 샘플)
void __attribute__((interrupt)) RX_ISR(void) {
    buffer[head] = iq_sample;              // 데이터 쓰기
    int next_head = (head + 1) & MASK;     // Lock-free increment
    head = next_head;                      // Memory barrier 자동
}

// Consumer: Main loop (데이터 처리)
bool pop_sample(int* sample) {
    if (head == tail) return false;        // Empty 체크
    *sample = buffer[tail];                // 데이터 읽기  
    tail = (tail + 1) & MASK;              // Consumer increment
    return true;
}

int get_count(void) {
    return (head - tail) & MASK;           // 사용 중인 샘플 수
}
