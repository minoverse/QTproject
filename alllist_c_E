#define BUF_SIZE 1024
static int buffer[BUF_SIZE];
static volatile int head = 0, tail = 0;

bool is_full(void) {
    return (head + 1) & (BUF_SIZE-1) == tail;  // 1칸 남김
}

bool is_empty(void) {
    return head == tail;
}

bool push(int value) {
    if (is_full()) return false;
    buffer[head] = value;
    head = (head + 1) & (BUF_SIZE-1);
    return true;
}
방법 2: Count 변수 (공간 100%)
c
static volatile int count = 0;

bool is_full(void) { return count == BUF_SIZE; }
bool is_empty(void) { return count == 0; }

bool push_safe(int value) {
    if (is_full()) return false;
    buffer[head] = value;
    head = (head + 1) & MASK;
    count++;  // Atomic 증가
    return true;
}

bool pop_safe(int* value) {
    if (is_empty()) return false;
    *value = buffer[tail];
    tail = (tail + 1) & MASK;
    count--;
    return true;
}
방법 3: Full Flag (ISR 안전)
c
static volatile bool full_flag = false;

bool is_full(void) { return full_flag; }
bool is_empty(void) { return head == tail && !full_flag; }

bool push_safe(int value) {
    if (full_flag) return false;
    buffer[head] = value;
    int next_head = (head + 1) & MASK;
    if (next_head == tail) full_flag = true;
    head = next_head;
    return true;
}

bool pop_safe(int* value) {
    if (is_empty()) return false;
    *value = buffer[tail];
    tail = (tail + 1) & MASK;
    full_flag = false;
    return true;
}
