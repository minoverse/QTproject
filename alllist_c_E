#define BUF_SIZE 1024
#define MASK (BUF_SIZE-1)
static int buffer[BUF_SIZE];
static volatile int head = 0, tail = 0;

bool push_overwrite(int value) {
    buffer[head] = value;                    // 항상 쓰기
    int next_head = (head + 1) & MASK;       // Power-of-2 최적화
    if (next_head == tail) {                 // Full → tail 밀어냄
        tail = (tail + 1) & MASK;            // 가장 오래된 데이터 삭제
    }
    head = next_head;
    return true;
}
