 부호비트

값 = 정수값 / 32768

예시:
 16384 / 32768 = 0.5        → 0x4000 = 0100 0000 0000 0000
  8192 / 32768 = 0.25       → 0x2000
-16384 / 32768 = -0.5       → 0xC000
 32767 / 32768 = 0.99996... → 0x7FFF (최댓값)
-32768 / 32768 = -1.0       → 0x8000 (최솟값)
Q15 연산 완전 정리
ctypedef int16_t q15_t;
typedef int32_t q31_t;

#define Q15_MAX      32767
#define Q15_MIN     -32768
#define Q15_ONE      32767   /* ≈ 1.0 */

/* ── 변환 ─────────────────────────────────────── */
#define FLOAT_TO_Q15(x)   ((q15_t)((x) * 32768.0f))
#define Q15_TO_FLOAT(x)   ((float)(x) / 32768.0f)

/* 예시 */
q15_t a = FLOAT_TO_Q15(0.5f);    /* = 16384  = 0x4000 */
q15_t b = FLOAT_TO_Q15(-0.25f);  /* = -8192  = 0xE000 */
q15_t c = FLOAT_TO_Q15(0.707f);  /* = 23170  ≈ √2/2  */

/* ── 덧셈 ─────────────────────────────────────── */
q15_t q15_add(q15_t a, q15_t b) {
    /* 그냥 정수 덧셈 — 소수점 위치 같으니까 */
    /* 0.5 + 0.25 = 16384 + 8192 = 24576 = 0.75 ✓ */
    int32_t result = (int32_t)a + (int32_t)b;
    /* overflow 처리 (saturation) */
    if (result >  Q15_MAX) return  Q15_MAX;
    if (result <  Q15_MIN) return  Q15_MIN;
    return (q15_t)result;
}

/* ── 곱셈 — 핵심 ──────────────────────────────── */
q15_t q15_mul(q15_t a, q15_t b) {
    /*
     * 왜 >> 15 인가?
     *
     * a = 0.5  → 16384  (소수점 15비트 뒤)
     * b = 0.5  → 16384  (소수점 15비트 뒤)
     *
     * 정수 곱셈:
     * 16384 * 16384 = 268,435,456
     *
     * 이 결과의 소수점 위치:
     * Q15 * Q15 = Q30 (소수점이 30비트 뒤)
     *
     * Q30 → Q15 로 변환:
     * 268,435,456 >> 15 = 8192
     *
     * 검증:
     * 8192 / 32768 = 0.25 = 0.5 * 0.5 ✓
     */
    return (q15_t)(((int32_t)a * (int32_t)b) >> 15);
}

/* ── 나눗셈 (거의 안씀) ────────────────────────── */
q15_t q15_div(q15_t a, q15_t b) {
    /* << 15 후 나누기 */
    return (q15_t)(((int32_t)a << 15) / (int32_t)b);
    /* 나눗셈은 느림 — 가능하면 곱셈으로 대체 */
}

/* ── 절댓값 ───────────────────────────────────── */
q15_t q15_abs(q15_t a) {
    return (a < 0) ? -a : a;
    /* 주의: Q15_MIN(-32768)의 절댓값은 Q15 범위 초과 */
}
