/* UART1 */
#define UART1_BASE    0x40011000u
#define UART1_SR      (*(volatile uint32_t*)(UART1_BASE + 0x00))  /* 상태 */
#define UART1_DR      (*(volatile uint32_t*)(UART1_BASE + 0x04))  /* 데이터 */
#define UART1_CR1     (*(volatile uint32_t*)(UART1_BASE + 0x0C))  /* 제어 */

/* GPIO A */
#define GPIOA_BASE    0x40020000u
#define GPIOA_IDR     (*(volatile uint32_t*)(GPIOA_BASE + 0x10))  /* 입력 */
#define GPIOA_ODR     (*(volatile uint32_t*)(GPIOA_BASE + 0x14))  /* 출력 */

/* Timer2 */
#define TIM2_BASE     0x40000000u
#define TIM2_CR1      (*(volatile uint32_t*)(TIM2_BASE + 0x00))   /* 제어 */
#define TIM2_CNT      (*(volatile uint32_t*)(TIM2_BASE + 0x24))   /* 카운터 */
#define TIM2_ARR      (*(volatile uint32_t*)(TIM2_BASE + 0x2C))   /* 자동 재로드 */
MMIO 실제 사용 예시
c/* ── LED 켜고 끄기 ─────────────────────────── */
/* PA5 = LED 핀 */
void led_on(void) {
    GPIOA_ODR |= (1u << 5);    /* bit5 set → PA5 HIGH → LED ON */
}
void led_off(void) {
    GPIOA_ODR &= ~(1u << 5);   /* bit5 clear → PA5 LOW → LED OFF */
}

/* ── 버튼 읽기 ──────────────────────────────── */
/* PA0 = 버튼 핀 */
int button_pressed(void) {
    return (GPIOA_IDR & (1u << 0)) == 0;  /* active low */
}

/* ── UART 바이트 전송 ────────────────────────── */
/* UART1_SR bit7 = TXE (TX buffer Empty) */
void uart_send_byte(uint8_t byte) {
    while (!(UART1_SR & (1u << 7))) {}  /* TXE 될 때까지 대기 */
    UART1_DR = byte;                    /* 레지스터에 쓰면 전송 시작 */
}

/* ── UART 바이트 수신 ────────────────────────── */
/* UART1_SR bit5 = RXNE (RX buffer Not Empty) */
uint8_t uart_recv_byte(void) {
    while (!(UART1_SR & (1u << 5))) {}  /* RXNE 될 때까지 대기 */
    return (uint8_t)UART1_DR;           /* 읽으면 하드웨어가 플래그 클리어 */
}
