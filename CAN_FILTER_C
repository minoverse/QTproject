1. FIXED POINT vs FLOATING POINT — 상세
왜 float가 문제인가
c// float는 이렇게 저장됨 (IEEE 754, 32비트)
// [1 sign][8 exponent][23 mantissa]
// 0 01111100 01000000000000000000000
//   → 0.15625

// 문제 1: 정밀도
float a = 0.1f;
float b = 0.2f;
float c = a + b;
// c == 0.3f ? → NO. c = 0.30000001192...
// 이유: 0.1, 0.2는 이진수로 정확히 표현 불가

// 문제 2: MCU에 FPU 없으면
float x = 1.5f;
float y = 2.5f;
float z = x * y;
// FPU 없는 MCU → 컴파일러가 소프트웨어 함수로 변환
// __aeabi_fmul() 호출 → 수십~수백 CPU 사이클
// 정수 곱셈은 1 사이클

// 문제 3: 비결정적 실행시간
// float 연산 시간이 입력값에 따라 달라짐
// 실시간 L1 처리에서 타이밍 보장 불가
Fixed Point 개념
c// 핵심 아이디어:
// 정수인데 소수점 위치를 약속으로 정함
//
// Q15 형식:
// 16비트 정수. 소수점이 15번째 비트 뒤에 있다고 약속
//
// 비트 표현:
// [S][.][b14][b13][b12]...[b0]
//  ↑  ↑
//  부호  소수점 (약속)
//
// 값 범위: -1.0 ~ +0.99996948...
// 해상도: 1/32768 = 0.0000305...

typedef int16_t q15_t;   // Q15
typedef int32_t q31_t;   // Q31

// 변환
#define FLOAT_TO_Q15(x)   ((q15_t)((x) * 32768.0f))
#define Q15_TO_FLOAT(x)   ((float)(x) / 32768.0f)

// 예시
q15_t a = FLOAT_TO_Q15(0.5f);   // 0.5 * 32768 = 16384 = 0x4000
q15_t b = FLOAT_TO_Q15(0.25f);  // 0.25 * 32768 = 8192 = 0x2000
Q15 연산
c// 덧셈 — 그냥 정수 덧셈
q15_t q15_add(q15_t a, q15_t b) {
    return (q15_t)(a + b);
    // 주의: overflow 가능 → saturation 추가 필요
}

// saturation 덧셈 (overflow 방지)
q15_t q15_add_sat(q15_t a, q15_t b) {
    int32_t result = (int32_t)a + (int32_t)b;
    if (result >  32767) return  32767;  // 최댓값 클램프
    if (result < -32768) return -32768;  // 최솟값 클램프
    return (q15_t)result;
}

// 곱셈 — 핵심: 32비트로 곱한 뒤 15 shift
q15_t q15_mul(q15_t a, q15_t b) {
    // a = 0.5  → 16384
    // b = 0.5  → 16384
    // 16384 * 16384 = 268,435,456  (int32_t에 들어감)
    // >> 15 = 8192 = 0.25 in Q15  ✓
    return (q15_t)(((int32_t)a * (int32_t)b) >> 15);
}

// 왜 >> 15 인가?
// Q15 * Q15 = Q30 (소수점이 30비트 뒤)
// Q30 → Q15 로 변환하려면 15비트 오른쪽 shift

// Q31 곱셈 (32비트 버전)
q31_t q31_mul(q31_t a, q31_t b) {
    return (q31_t)(((int64_t)a * (int64_t)b) >> 31);
}
실제 사용 예시 — 볼륨 조절
c// 오디오 샘플에 볼륨(0.0~1.0) 적용
// float 버전 (FPU 없으면 느림)
int16_t apply_volume_float(int16_t sample, float volume) {
    return (int16_t)(sample * volume);
}

// Q15 버전 (빠름, 결정적)
int16_t apply_volume_q15(int16_t sample, q15_t volume) {
    // sample * volume → 32비트로 곱한 뒤 15 shift
    return (int16_t)(((int32_t)sample * volume) >> 15);
}

// 사용
q15_t vol = FLOAT_TO_Q15(0.75f);  // 75% 볼륨
int16_t out = apply_volume_q15(input_sample, vol);
핵심 답변
Q: "fixed point가 뭔가요?"
A: "정수로 소수점을 표현하는 방법입니다.
    Q15는 16비트 정수인데 소수점이 15번째 비트 뒤에 있다고
    약속합니다. 값 범위는 -1.0 ~ +1.0입니다.
    곱셈은 int32_t로 곱한 뒤 15비트 오른쪽 shift 합니다.
    FPU 없는 MCU에서 float보다 수십 배 빠릅니다."

Q: "Q15와 Q31 차이?"
A: "정밀도 차이입니다. Q15는 16비트로 1/32768 해상도,
    Q31은 32비트로 1/2147483648 해상도입니다.
    Q31이 더 정밀하지만 메모리를 두 배 씁니다."

2. INLINE — 상세
함수 호출 오버헤드가 뭔가?
c// 일반 함수 호출 시 CPU가 하는 일:
int add(int a, int b) { return a + b; }

int main(void) {
    int result = add(3, 4);
    // 내부적으로:
    // 1. 인자 3, 4를 스택에 push
    // 2. return address를 스택에 저장
    // 3. add 함수 주소로 jump
    // 4. 함수 실행
    // 5. return address로 jump back
    // 6. 스택 정리
    // → 짧은 함수인데 이 오버헤드가 실제 계산보다 클 수 있음
}

// inline 함수: 호출 대신 코드 자체를 복사해 넣음
static inline int add_inline(int a, int b) { return a + b; }

// 컴파일러가 이렇게 변환:
// int result = add_inline(3, 4);
// → int result = 3 + 4;  // 함수 호출 없음, 직접 계산
macro와 비교 — 왜 inline이 더 안전한가
c// ── macro 버전 ──────────────────────────────
#define MAX_MACRO(a, b)  ((a) > (b) ? (a) : (b))

int x = 5;
int y = MAX_MACRO(x++, 3);
// 전처리 후: ((x++) > (3) ? (x++) : (3))
// x++가 두 번 평가됨!
// 결과: x = 7 (예상: 6), y = 6 (예상: 5)
// 버그: 부작용 (side effect)

// ── inline 버전 ─────────────────────────────
static inline int max_inline(int a, int b) {
    return a > b ? a : b;
}

int x = 5;
int y = max_inline(x++, 3);
// x++는 한 번만 평가됨
// 결과: x = 6, y = 5  ✓

// ── 타입 안전성 ──────────────────────────────
#define DOUBLE_MACRO(x)  ((x) * 2)
// DOUBLE_MACRO(3.14f) → float도 동작 (의도치 않게)
// DOUBLE_MACRO("hello") → 컴파일 오류 안남, 쓰레기값

static inline int double_int(int x) { return x * 2; }
// double_int(3.14f) → 컴파일러 경고 또는 자동 변환
// double_int("hello") → 컴파일 오류 ✓
inline이 항상 빠른가? — NO
c// inline의 단점: 코드 크기 증가
// 함수가 10군데서 호출되면 → 코드가 10배 복사됨
// I-cache miss 증가 가능 → 오히려 느려질 수 있음

// 좋은 inline 후보: 1~3줄, 자주 호출, 루프 안
static inline uint8_t get_bit(uint32_t reg, int pos) {
    return (reg >> pos) & 1u;  // 1줄 → inline 적합
}

// 나쁜 inline 후보: 길고 복잡한 함수
// inline으로 선언해도 컴파일러가 무시할 수 있음
// inline은 "힌트"일 뿐, 강제가 아님
임베디드에서 실제 사용 패턴
c// 헤더에 static inline으로 선언
// → 여러 .c 파일에서 include해도 중복 정의 오류 없음

// reg_utils.h
static inline void set_bit(volatile uint32_t* reg, int pos) {
    *reg |= (1u << pos);
}
static inline void clear_bit(volatile uint32_t* reg, int pos) {
    *reg &= ~(1u << pos);
}
static inline int check_bit(volatile uint32_t* reg, int pos) {
    return (*reg >> pos) & 1u;
}
// 이런 유틸리티 함수들이 inline의 가장 전형적인 사용처
 핵심 답변
Q: "macro 대신 inline을 써야 하는 이유?"
A: "세 가지입니다.
    첫째, 부작용이 없습니다. macro는 인자를 여러 번
    평가할 수 있어 i++ 같은 인자가 위험합니다.
    둘째, 타입 안전합니다. 컴파일러가 타입을 검사합니다.
    셋째, 디버거에서 보입니다. macro는 전처리 후 사라지지만
    inline 함수는 디버깅할 수 있습니다."

Q: "inline이 항상 함수 호출보다 빠른가요?"
A: "아닙니다. 함수가 길면 코드가 복사되어 크기가 커지고
    I-cache miss가 증가할 수 있습니다.
    1~3줄의 짧은 함수, 루프 안에서 자주 호출되는 함수에만
    inline을 씁니다."

3. MMIO + volatile — 상세
MMIO가 뭔가
c// 일반 메모리 접근:
int x = 5;      // RAM 주소 0x20001000에 저장
x = 10;         // 같은 주소에 10 저장

// MMIO:
// CPU 주소 공간의 특정 주소가
// RAM이 아니라 하드웨어 레지스터에 연결됨
//
// 주소 맵 예시 (STM32):
// 0x20000000 ~ 0x2001FFFF → RAM
// 0x40001000 → UART1_DR   (데이터 레지스터)
// 0x40001004 → UART1_SR   (상태 레지스터)
// 0x40020000 → GPIOA_IDR  (GPIO 입력)
// 0x40020014 → GPIOA_ODR  (GPIO 출력)
//
// 이 주소에 쓰면 → 하드웨어가 동작
// 이 주소를 읽으면 → 하드웨어 현재 상태

#define GPIOA_ODR  (*(volatile uint32_t*)(0x40020014))

GPIOA_ODR |= (1u << 5);   // PA5 핀을 HIGH로 → LED 켜짐
GPIOA_ODR &= ~(1u << 5);  // PA5 핀을 LOW로  → LED 꺼짐
volatile이 없으면 무슨 일이 생기나
c// ── 예시 1: 상태 레지스터 폴링 ──────────────────
#define UART_SR  (*(uint32_t*)(0x40001004))  // volatile 없음!
#define UART_DR  (*(uint32_t*)(0x40001000))

void uart_send_wrong(uint8_t byte) {
    while (!(UART_SR & 0x80u)) {}  // TX 버퍼 비었나 확인
    UART_DR = byte;
}

// 컴파일러 입장:
// "UART_SR을 처음 읽었는데 0이네.
//  아무도 UART_SR을 바꾸는 코드가 없으니
//  다음번에도 0일 거야. while 루프 조건이 항상 true."
// 최적화 결과:
// while(1) {}  ← 무한루프! UART_DR에 절대 못 씀

// volatile 추가하면:
#define UART_SR  (*(volatile uint32_t*)(0x40001004))
// 컴파일러: "volatile이니까 매번 실제 메모리에서 읽어야 함"
// → 하드웨어가 TX 완료 후 UART_SR을 바꾸면 루프 탈출 ✓


// ── 예시 2: GPIO 읽기 ────────────────────────────
#define GPIOA_IDR (*(uint32_t*)(0x40020010))  // volatile 없음!

int read_button(void) {
    int a = GPIOA_IDR & (1u << 0);  // 첫 번째 읽기
    int b = GPIOA_IDR & (1u << 0);  // 두 번째 읽기
    return a & b;
}

// 컴파일러 최적화:
// "GPIOA_IDR을 두 번 읽는데 사이에 아무것도 없네.
//  같은 값일 테니 한 번만 읽고 재사용할게."
// → 버튼이 두 번 읽는 사이에 눌려도 감지 못함!

// volatile 추가:
#define GPIOA_IDR (*(volatile uint32_t*)(0x40020010))
// → 컴파일러가 매번 실제 레지스터에서 읽음 ✓


// ── 예시 3: ISR과 main 공유 변수 ────────────────
int flag = 0;         // volatile 없음!

void TIMER_ISR(void) {
    flag = 1;         // ISR에서 flag 변경
}

void main_loop(void) {
    while (!flag) {}  // flag가 1이 될 때까지 대기
    do_work();
}

// 컴파일러 최적화 (O2 이상):
// "while(!flag) 루프에서 flag를 바꾸는 코드가 없네.
//  flag는 항상 0이니까 이렇게 바꿀게:"
// while(1) {}   ← 무한루프! do_work() 절대 실행 안됨

// 해결:
volatile int flag = 0;  // ✓
volatile 동작 원리 — 어셈블리 레벨
c// volatile 없는 경우 — 컴파일러 최적화
uint32_t* ptr = (uint32_t*)0x40001004;
uint32_t  val = *ptr;   // 레지스터에 로드
if (val & 0x80u) {}     // 레지스터 값 사용
if (val & 0x80u) {}     // 같은 레지스터 값 재사용 (메모리 안읽음)

// 어셈블리:
// LDR R0, [0x40001004]   ; 한 번만 읽음
// TST R0, #0x80
// TST R0, #0x80           ; R0 재사용

// volatile 있는 경우
volatile uint32_t* ptr = (volatile uint32_t*)0x40001004;
if (*ptr & 0x80u) {}    // 메모리에서 읽음
if (*ptr & 0x80u) {}    // 또 메모리에서 읽음

// 어셈블리:
// LDR R0, [0x40001004]   ; 첫 번째 읽기
// TST R0, #0x80
// LDR R0, [0x40001004]   ; 두 번째 읽기 (하드웨어 값 변했을 수 있음)
// TST R0, #0x80
volatile 규칙 정리
c// 1. 하드웨어 레지스터 (MMIO) → 항상 volatile
#define UART_DR (*(volatile uint32_t*)(0x40001000))

// 2. ISR과 공유하는 변수 → volatile
volatile int rx_flag = 0;

// 3. DMA가 쓰는 버퍼 → volatile
volatile uint8_t dma_buffer[64];

// 4. 멀티스레드 공유 변수 → volatile + mutex
// (volatile만으로는 원자성 보장 안됨!)
volatile int counter = 0;
// counter++ 는 read-modify-write 3단계
// volatile이 있어도 두 스레드가 동시에 하면 race condition
// → mutex로 보호해야 함
 핵심 답변
Q: "MMIO가 뭔가요?"
A: "CPU 주소 공간의 특정 주소가 RAM이 아닌
    하드웨어 레지스터에 매핑된 것입니다.
    그 주소에 쓰면 하드웨어 동작이 바뀌고,
    읽으면 하드웨어 현재 상태를 알 수 있습니다."

Q: "MMIO에서 volatile이 왜 필요한가요?"
A: "컴파일러는 최적화 시 같은 주소를 두 번 읽으면
    두 번째를 건너뛸 수 있습니다.
    일반 RAM이면 맞는 최적화지만
    하드웨어 레지스터는 CPU 모르게 하드웨어가 값을 바꿉니다.
    volatile이 없으면 while(!(UART_SR & 0x80)) 같은
    폴링 루프가 무한루프로 최적화될 수 있습니다.
    volatile은 컴파일러에게 '이 주소는 매번 실제로 읽어라'
    라고 지시합니다."

Q: "volatile이 스레드 안전을 보장하나요?"
A: "아닙니다. volatile은 컴파일러 최적화만 막습니다.
    counter++ 같은 read-modify-write 연산은
    volatile이 있어도 두 스레드가 동시에 하면
    race condition이 발생합니다.
    스레드 안전은 mutex나 atomic으로 따로 보장해야 합니다."

