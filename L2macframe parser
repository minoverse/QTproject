BUG
data is never null-checked — dereferencing NULL is undefined behaviour.
2
BUG
data[1] << 8: uint8_t is promoted to int before shift. On 16-bit platforms this overflows. Cast to uint16_t first.
3
BUG
data[3] << 24: shifting a signed int left by 24 bits can overflow into the sign bit — undefined behaviour. Must cast to uint32_t.
4
BUG
static_cast<FrameType>(header.type): if type is 3–15 there is no matching enum value — undefined behaviour. Validate before casting.
5
QUALITY
No check that buffer is at least 7 bytes — caller could pass a 3-byte buffer causing out-of-bounds read.
6
QUALITY
No error return path — function returns FrameType but has no way to signal parse failure.
7
QUALITY
Endianness assumption is undocumented — big-endian byte order assumed but never stated.



Phase 2 — Test Cases  (~20 min)
Write test cases that catch every bug found in Phase 1. Cover: valid frames, invalid type, null pointer, short buffer, max values.

#include <cassert>
#include <cstdio>
#include "mac_parser.hpp"

// Test 1 — valid MAC frame, all fields parsed correctly
void test_valid_mac_frame() {
    // ver=1, type=0(MAC), len=100, seq=1
    uint8_t buf[] = {0x10, 0x00, 0x64, 0x00, 0x00, 0x00, 0x01};
    L2Header hdr{};
    auto result = parse_header(buf, sizeof(buf), hdr);
    assert(result.has_value());
    assert(*result == FrameType::MAC);
    assert(hdr.version == 1);
    assert(hdr.length  == 100);
    assert(hdr.seq_num == 1);
    printf("PASS test_valid_mac_frame\n");
}

// Test 2 — valid RLC frame
void test_valid_rlc_frame() {
    uint8_t buf[] = {0x21, 0x01, 0x00, 0x00, 0x00, 0x00, 0x05};
    L2Header hdr{};
    auto result = parse_header(buf, sizeof(buf), hdr);
    assert(result.has_value());
    assert(*result == FrameType::RLC);
    printf("PASS test_valid_rlc_frame\n");
}

// Test 3 — invalid type (15) must return error
void test_invalid_frame_type() {
    uint8_t buf[] = {0x0F, 0x00, 0x10, 0x00, 0x00, 0x00, 0x00};
    L2Header hdr{};
    auto result = parse_header(buf, sizeof(buf), hdr);
    assert(!result.has_value());
    printf("PASS test_invalid_frame_type\n");
}

// Test 4 — null pointer must not crash
void test_null_pointer() {
    L2Header hdr{};
    auto result = parse_header(nullptr, 7, hdr);
    assert(!result.has_value());
    printf("PASS test_null_pointer\n");
}

// Test 5 — buffer too short must return error
void test_buffer_too_short() {
    uint8_t buf[] = {0x10, 0x00, 0x64};
    L2Header hdr{};
    auto result = parse_header(buf, sizeof(buf), hdr);
    assert(!result.has_value());
    printf("PASS test_buffer_too_short\n");
}

// Test 6 — max values: length=0xFFFF, seq=0xFFFFFFFF
void test_max_values() {
    uint8_t buf[] = {0x10, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF};
    L2Header hdr{};
    auto result = parse_header(buf, sizeof(buf), hdr);
    assert(result.has_value());
    assert(hdr.length  == 0xFFFF);
    assert(hdr.seq_num == 0xFFFFFFFF);
    printf("PASS test_max_values\n");
}

int main() {
    test_valid_mac_frame();
    test_valid_rlc_frame();
    test_invalid_frame_type();
    test_null_pointer();
    test_buffer_too_short();
    test_max_values();
    printf("All tests passed.\n");
}



Phase 3 — Implementation  (~25 min)
Write the correct implementation from scratch. Fix all bugs. Use std::optional for error signalling.

// mac_parser.hpp — correct version
#pragma once
#include <cstdint>
#include <optional>

enum class FrameType : uint8_t { MAC = 0, RLC = 1, PDCP = 2 };

struct L2Header {
    uint8_t  version;
    uint8_t  type;
    uint16_t length;
    uint32_t seq_num;
};

static constexpr std::size_t L2_HEADER_SIZE = 7u;

std::optional<FrameType> parse_header(
    const uint8_t* data,
    std::size_t    len,
    L2Header&      header)
{
    if (data == nullptr || len < L2_HEADER_SIZE)
        return std::nullopt;

    header.version = static_cast<uint8_t>(data[0] >> 4u);
    header.type    = static_cast<uint8_t>(data[0] & 0x0Fu);

    // Validate type before casting to enum
    if (header.type > static_cast<uint8_t>(FrameType::PDCP))
        return std::nullopt;

    // Cast to wider type BEFORE shifting to avoid UB
    header.length = static_cast<uint16_t>(
        (static_cast<uint16_t>(data[1]) << 8u) |
         static_cast<uint16_t>(data[2]));

    header.seq_num =
        (static_cast<uint32_t>(data[3]) << 24u) |
        (static_cast<uint32_t>(data[4]) << 16u) |
        (static_cast<uint32_t>(data[5]) <<  8u) |
         static_cast<uint32_t>(data[6]);

    return static_cast<FrameType>(header.type);
}


Follow-up questions — be ready to answer
Why std::optional instead of returning -1 or throwing? — No exception overhead, caller is forced to check, explicit API contract.
What is integer promotion? — uint8_t promotes to int before arithmetic. Dangerous on shifts if int is narrow.
If this ran on a little-endian CPU reading a big-endian wire format, what breaks? — length and seq_num would be byte-swapped.
How would you make this thread-safe? — Function is already stateless/reentrant — safe as-is if each thread has its own hdr.

