/* ═══════════════════════════════════════════════════════
   memcpy — copies n bytes from src to dst
   WARNING: src and dst must NOT overlap
   ═══════════════════════════════════════════════════════ */
void* my_memcpy(void* dst, const void* src, size_t n) {
    if (dst == NULL || src == NULL) return NULL;

    uint8_t*       d = (uint8_t*)dst;
    const uint8_t* s = (const uint8_t*)src;

    while (n--) {
        *d++ = *s++;
    }
    return dst;
}
/* KEY POINT: copies forward only — overlapping regions corrupt data
   e.g. my_memcpy(buf+1, buf, 5) — s and d overlap → WRONG result */


/* ═══════════════════════════════════════════════════════
   memmove — copies n bytes, SAFE even if src/dst overlap
   ═══════════════════════════════════════════════════════ */
void* my_memmove(void* dst, const void* src, size_t n) {
    if (dst == NULL || src == NULL) return NULL;

    uint8_t*       d = (uint8_t*)dst;
    const uint8_t* s = (const uint8_t*)src;

    if (d < s) {
        /* no overlap risk — copy forward */
        while (n--) *d++ = *s++;
    } else {
        /* dst is ahead of src — copy backward to avoid overwrite */
        d += n;
        s += n;
        while (n--) *--d = *--s;
    }
    return dst;
}
/* KEY POINT: checks if dst > src — if so copies backward
   This is the only difference from memcpy */


/* ═══════════════════════════════════════════════════════
   strcpy — copies string including '\0'
   WARNING: no size limit — buffer overflow risk
   ═══════════════════════════════════════════════════════ */
char* my_strcpy(char* dst, const char* src) {
    if (dst == NULL || src == NULL) return NULL;

    char* start = dst;
    while ((*dst++ = *src++) != '\0') {}
    return start;
}
/* KEY POINT: stops at null terminator — but if dst is too small
   it writes past the end → buffer overflow → NEVER use in embedded */


/* ═══════════════════════════════════════════════════════
   strncpy — copies at most n bytes
   WARNING: does NOT guarantee null termination if src >= n chars
   ═══════════════════════════════════════════════════════ */
char* my_strncpy(char* dst, const char* src, size_t n) {
    if (dst == NULL || src == NULL) return NULL;

    char* start = dst;
    while (n > 0 && *src != '\0') {
        *dst++ = *src++;
        n--;
    }
    /* pad remaining bytes with '\0' */
    while (n-- > 0) *dst++ = '\0';

    return start;
}
/* KEY POINT: if src is longer than n, dst has NO null terminator
   Always add manually: buf[n-1] = '\0' after strncpy */


/* ═══════════════════════════════════════════════════════
   strlcpy — copies at most (n-1) bytes, ALWAYS null terminates
   Safest option — preferred in modern embedded code
   ═══════════════════════════════════════════════════════ */
size_t my_strlcpy(char* dst, const char* src, size_t n) {
    if (dst == NULL || src == NULL) return 0;

    size_t src_len = 0;
    const char* s = src;
    while (*s++) src_len++;   /* measure src length */

    if (n == 0) return src_len;

    size_t copy = (src_len < n - 1) ? src_len : n - 1;
    size_t i;
    for (i = 0; i < copy; i++) dst[i] = src[i];
    dst[copy] = '\0';         /* always null terminate */

    return src_len;           /* returns full src length, not copied */
}
/* KEY POINT: always null terminates, returns src length
   Caller can check: if (strlcpy(dst,src,n) >= n) { truncated! } */


/* ═══════════════════════════════════════════════════════
   COMPARISON TABLE — say this in interview
   ═══════════════════════════════════════════════════════

   memcpy  — fastest, no overlap, no null terminator
   memmove — overlap safe, no null terminator
   strcpy  — null terminated, no size limit = dangerous
   strncpy — size limited but may NOT null terminate
   strlcpy — size limited, always null terminates = safest

   In embedded: use memmove or strlcpy. Never strcpy.
   ═══════════════════════════════════════════════════════ */


/* ═══════════════════════════════════════════════════════
   EXTRACT NUMBER FROM STRING — "adv123" → 123
   Ericsson L2 interview task
   ═══════════════════════════════════════════════════════ */
int extract_number(const char* str) {
    if (str == NULL) return -1;

    int result   = 0;
    int found    = 0;   /* found at least one digit */
    int negative = 0;

    while (*str != '\0') {
        if (*str == '-' && !found) {
            negative = 1;
        } else if (*str >= '0' && *str <= '9') {
            result = result * 10 + (*str - '0');
            found  = 1;
        }
        str++;
    }

    if (!found) return -1;   /* no digits found */
    return negative ? -result : result;
}

/* Examples:
   "adv123"   → 123
   "abc-45z"  → -45
   "hello"    → -1  (no digits)
   "12abc34"  → 1234  (collects all digits)
   ""         → -1
   NULL       → -1
*/

/* Test cases for extract_number */
void test_extract_number(void) {
    assert(extract_number("adv123")   == 123);
    assert(extract_number("abc-45z")  == -45);
    assert(extract_number("hello")    == -1);
    assert(extract_number("12abc34")  == 1234);
    assert(extract_number(NULL)       == -1);
    assert(extract_number("")         == -1);
    printf("PASS test_extract_number\n");
}


/* ═══════════════════════════════════════════════════════
   BITWISE — recommended exercises
   ═══════════════════════════════════════════════════════ */

/* 1. Count set bits (popcount) */
int count_set_bits(uint32_t n) {
    int count = 0;
    while (n) {
        count += n & 1u;
        n >>= 1;
    }
    return count;
}

/* 2. Check if power of 2 */
int is_power_of_two(uint32_t n) {
    if (n == 0) return 0;
    return (n & (n - 1)) == 0;
}
/* KEY POINT: power of 2 has exactly one bit set
   n=8: 1000, n-1=0111, AND=0000 → yes
   n=6: 0110, n-1=0101, AND=0100 → no  */

/* 3. Swap two numbers without temp variable */
void swap_bits(int* a, int* b) {
    if (a == NULL || b == NULL) return;
    *a ^= *b;
    *b ^= *a;
    *a ^= *b;
}

/* 4. Reverse bits of a byte */
uint8_t reverse_bits(uint8_t byte) {
    uint8_t result = 0;
    int i;
    for (i = 0; i < 8; i++) {
        result = (result << 1) | (byte & 1u);
        byte >>= 1;
    }
    return result;
}

/* 5. Get / Set / Clear / Toggle bit at position pos */
uint32_t get_bit   (uint32_t reg, int pos) { return (reg >> pos) & 1u; }
uint32_t set_bit   (uint32_t reg, int pos) { return reg |  (1u << pos); }
uint32_t clear_bit (uint32_t reg, int pos) { return reg & ~(1u << pos); }
uint32_t toggle_bit(uint32_t reg, int pos) { return reg ^  (1u << pos); }

/* 6. Extract N bits starting at position pos */
uint32_t extract_bits(uint32_t val, int pos, int n) {
    uint32_t mask = (1u << n) - 1u;
    return (val >> pos) & mask;
}
/* Example: extract_bits(0xABCD, 4, 8) → 0xBC
   val  = 1010 1011 1100 1101
   >>4  = 0000 1010 1011 1100
   mask = 0000 0000 1111 1111 (8 bits)
   AND  = 0000 0000 1011 1100 = 0xBC  */


/* ═══════════════════════════════════════════════════════
   ARRAY AND POINTER — recommended exercises
   ═══════════════════════════════════════════════════════ */

/* 1. Reverse an array in place */
void reverse_array(int* arr, int len) {
    if (arr == NULL || len <= 0) return;
    int left  = 0;
    int right = len - 1;
    while (left < right) {
        int tmp      = arr[left];
        arr[left]    = arr[right];
        arr[right]   = tmp;
        left++;
        right--;
    }
}

/* 2. Find max in array */
int find_max(const int* arr, int len) {
    if (arr == NULL || len <= 0) return -1;
    int max = arr[0];
    int i;
    for (i = 1; i < len; i++) {
        if (arr[i] > max) max = arr[i];
    }
    return max;
}

/* 3. Pointer arithmetic — what interviewers test */
void pointer_examples(void) {
    int arr[5] = {10, 20, 30, 40, 50};
    int* p = arr;

    /* these are all equivalent */
    /* arr[2]  ==  *(arr + 2)  ==  *(p + 2)  ==  p[2] */

    /* pointer difference */
    int* p2 = &arr[3];
    /* p2 - p == 3  (number of elements, not bytes) */

    /* sizeof */
    /* sizeof(arr) == 20  (5 * 4 bytes) */
    /* sizeof(p)   ==  8  (pointer size, not array size!) */
    /* KEY BUG in interviews: passing array to function loses size info */
}

/* 4. String length without strlen */
int my_strlen(const char* str) {
    if (str == NULL) return -1;
    int len = 0;
    while (*str++ != '\0') len++;
    return len;
}
