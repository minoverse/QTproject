// ============================================================
// 1) DPDK-style Ring Buffer (template + atomic)
// ============================================================
template <typename T, size_t Capacity>
class RingBuffer {
    static_assert(Capacity >= 2, "Capacity must be at least 2");

public:
    RingBuffer() : head_(0), tail_(0) {}

    bool push(const T& value) {
        size_t head = head_.load(std::memory_order_relaxed);
        size_t next = (head + 1) % Capacity;
        if (next == tail_.load(std::memory_order_acquire)) {
            return false; // full
        }

        buffer_[head] = value;
        head_.store(next, std::memory_order_release);
        return true;
    }

    bool pop(T& out) {
        size_t tail = tail_.load(std::memory_order_relaxed);
        if (tail == head_.load(std::memory_order_acquire)) {
            return false; // empty
        }

        out = buffer_[tail];
        tail_.store((tail + 1) % Capacity, std::memory_order_release);
        return true;
    }

    bool empty() const {
        return head_.load(std::memory_order_acquire) ==
               tail_.load(std::memory_order_acquire);
    }

    bool full() const {
        size_t head = head_.load(std::memory_order_acquire);
        return ((head + 1) % Capacity) == tail_.load(std::memory_order_acquire);
    }

    size_t size() const {
        size_t head = head_.load(std::memory_order_acquire);
        size_t tail = tail_.load(std::memory_order_acquire);
        if (head >= tail) return head - tail;
        return Capacity - (tail - head);
    }

    void reset() {
        head_.store(0, std::memory_order_release);
        tail_.store(0, std::memory_order_release);
    }

private:
    std::atomic<size_t> head_;
    std::atomic<size_t> tail_;
    T buffer_[Capacity];
};

// ============================================================
// 2) Thread Pool
// ============================================================
class ThreadPool {
public:
    explicit ThreadPool(size_t num_threads)
        : stop_(false) {
        if (num_threads == 0) num_threads = 1;

        for (size_t i = 0; i < num_threads; ++i) {
            workers_.emplace_back([this] {
                for (;;) {
                    std::function<void()> task;
                    {
                        std::unique_lock<std::mutex> lock(mutex_);
                        cv_.wait(lock, [this] {
                            return stop_ || !tasks_.empty();
                        });

                        if (stop_ && tasks_.empty()) {
                            return;
                        }

                        task = std::move(tasks_.front());
                        tasks_.pop();
                    }

                    task();
                }
            });
        }
    }

    ~ThreadPool() {
        shutdown();
    }

    template <typename F>
    auto submit(F&& f) -> std::future<std::invoke_result_t<F>> {
        using Ret = std::invoke_result_t<F>;

        auto task = std::make_shared<std::packaged_task<Ret()>>(
            std::forward<F>(f)
        );
        std::future<Ret> fut = task->get_future();

        {
            std::lock_guard<std::mutex> lock(mutex_);
            if (stop_) {
                throw std::runtime_error("ThreadPool is stopped");
            }
            tasks_.emplace([task]() { (*task)(); });
        }

        cv_.notify_one();
        return fut;
    }

    void shutdown() {
        {
            std::lock_guard<std::mutex> lock(mutex_);
            if (stop_) return;
            stop_ = true;
        }

        cv_.notify_all();

        for (auto& t : workers_) {
            if (t.joinable()) {
                t.join();
            }
        }
        workers_.clear();
    }

private:
    std::vector<std::thread> workers_;
    std::queue<std::function<void()>> tasks_;
    std::mutex mutex_;
    std::condition_variable cv_;
    bool stop_;
};

// ============================================================
// 3) Packet Parser
//    Format:
//    [0] : version(4 bits) | type(4 bits)
//    [1-2]: length (big-endian)
//    [3-6]: seq_num (big-endian)
// ============================================================
struct PacketHeader {
    uint8_t version = 0;
    uint8_t type = 0;
    uint16_t length = 0;
    uint32_t seq_num = 0;
};

class PacketParser {
public:
    static constexpr size_t HEADER_SIZE = 7;

    static bool parse(const uint8_t* data, size_t len, PacketHeader& header) {
        if (!data) return false;
        if (len < HEADER_SIZE) return false;

        header.version = data[0] >> 4;
        header.type = data[0] & 0x0F;
        header.length = (static_cast<uint16_t>(data[1]) << 8) |
                        static_cast<uint16_t>(data[2]);
        header.seq_num = (static_cast<uint32_t>(data[3]) << 24) |
                         (static_cast<uint32_t>(data[4]) << 16) |
                         (static_cast<uint32_t>(data[5]) << 8) |
                         static_cast<uint32_t>(data[6]);

        return is_valid(header);
    }

    static bool is_valid(const PacketHeader& header) {
        if (header.version > 15) return false;
        if (header.type > 2) return false;       // 0=MAC, 1=RLC, 2=PDCP
        if (header.length == 0) return false;
        return true;
    }
};

// ============================================================
// 4) Sequence Missing Detector
// ============================================================
struct SeqStats {
    uint32_t expected_seq = 1;
    uint32_t gap_count = 0;
    uint32_t drop_count = 0;
};

class SequenceDetector {
public:
    explicit SequenceDetector(uint32_t start_seq = 1)
        : expected_seq_(start_seq) {}

    bool observe(uint32_t seq) {
        if (seq == expected_seq_) {
            ++expected_seq_;
            return true;
        }

        if (seq > expected_seq_) {
            uint32_t gap = seq - expected_seq_;
            gap_count_ += gap;
            drop_count_ += gap;
            expected_seq_ = seq + 1;
            return false;
        }

        return false; // late / duplicate
    }

    SeqStats stats() const {
        return SeqStats{expected_seq_, gap_count_, drop_count_};
    }

private:
    uint32_t expected_seq_;
    uint32_t gap_count_ = 0;
    uint32_t drop_count_ = 0;
};

// ============================================================
// 5) Minimal Tests
// ============================================================
void test_ring_buffer() {
    RingBuffer<int, 8> rb;
    assert(rb.empty());
    assert(!rb.full());

    assert(rb.push(1));
    assert(rb.push(2));
    assert(rb.push(3));

    int x = 0;
    assert(rb.pop(x) && x == 1);
    assert(rb.pop(x) && x == 2);
    assert(rb.pop(x) && x == 3);
    assert(rb.empty());

    for (int i = 0; i < 7; ++i) {
        assert(rb.push(i));
    }
    assert(rb.full());
    assert(!rb.push(100));
}

void test_thread_pool() {
    ThreadPool pool(2);

    auto f1 = pool.submit([] { return 42; });
    auto f2 = pool.submit([] { return 7 + 5; });

    assert(f1.get() == 42);
    assert(f2.get() == 12);

    pool.shutdown();
}

void test_packet_parser() {
    uint8_t raw[] = {
        0x12,       // version=1, type=2
        0x00, 0x07, // length=7
        0x00, 0x00, 0x00, 0x10
    };

    PacketHeader header;
    bool ok = PacketParser::parse(raw, sizeof(raw), header);
    assert(ok);
    assert(header.version == 1);
    assert(header.type == 2);
    assert(header.length == 7);
    assert(header.seq_num == 16);
}

void test_sequence_detector() {
    SequenceDetector det(1);

    assert(det.observe(1) == true);
    assert(det.observe(2) == true);
    assert(det.observe(4) == false);

    SeqStats s = det.stats();
    assert(s.expected_seq == 5);
    assert(s.gap_count == 1);
    assert(s.drop_count == 1);
}

// ============================================================
// 6) Demo main
// ============================================================
int main() {
    test_ring_buffer();
    test_thread_pool();
    test_packet_parser();
    test_sequence_detector();

    std::cout << "All tests passed.\n";
    return 0;
}
