#include <stdbool.h>

bool validUtf8(int* data, int dataSize) {
    int remaining_bytes = 0;

    for (int i = 0; i < dataSize; i++) {
        uint8_t byte = (uint8_t)(data[i] & 0xFF); // 하위 8비트만 사용

        if (remaining_bytes == 0) {
            // 새로운 문자의 시작 바이트 분석
            if ((byte >> 7) == 0) {
                // 1바이트 문자 (0xxxxxxx)
                remaining_bytes = 0;
            } else if ((byte >> 5) == 0b110) {
                // 2바이트 문자 시작 (110xxxxx)
                remaining_bytes = 1;
            } else if ((byte >> 4) == 0b1110) {
                // 3바이트 문자 시작 (1110xxxx)
                remaining_bytes = 2;
            } else if ((byte >> 3) == 0b11110) {
                // 4바이트 문자 시작 (11110xxx)
                remaining_bytes = 3;
            } else {
                // 유효하지 않은 시작 비트 패턴 (예: 10xxxxxx가 맨 앞에 옴)
                return false;
            }
        } else {
            // 후속 바이트 검사 (반드시 10xxxxxx 형태여야 함)
            if ((byte >> 6) != 0b10) {
                return false;
            }
            remaining_bytes--;
        }
    }

    // 모든 바이트를 소모했을 때 카운터가 0이어야 함 (중간에 끊기면 안 됨)
    return remaining_bytes == 0;
}

